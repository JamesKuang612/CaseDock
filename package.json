{
  "name": "casedock",
  "version": "0.1.0-beta.0",
  "description": "跨 Agent 的本地测试资产与证据工作台",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesKuang612/CaseDock.git"
  },
  "homepage": "https://github.com/JamesKuang612/CaseDock#readme",
  "bugs": {
    "url": "https://github.com/JamesKuang612/CaseDock/issues"
  },
  "keywords": ["testing", "agent", "evidence", "test-cases", "local-first"],
  "type": "module",
  "bin": {
    "casedock": "build/cli.js"
  },
  "files": ["build", "skills", "examples/sample-workspace", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch src/cli.ts --root examples/sample-workspace open --port 4310 --no-open --dev",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsup && vite build",
    "start": "node build/cli.js --root examples/sample-workspace open",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && node --import tsx --test tests/*.e2e.ts",
    "format": "prettier --write src tests vite.config.ts tsup.config.ts",
    "format:check": "prettier --check src tests vite.config.ts tsup.config.ts",
    "check": "npm run format:check && npm run test && npm run build",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "ajv": "8.20.0",
    "antd": "6.6.3",
    "commander": "15.0.0",
    "fastify": "5.12.4",
    "open": "11.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
