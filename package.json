{
  "name": "@casedock/workbench",
  "version": "0.1.0",
  "private": true,
  "description": "A local test asset workbench for the agent your team chooses.",
  "type": "module",
  "bin": {
    "casedock": "build/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch src/cli.ts app --no-open",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsup && vite build",
    "start": "node build/cli.js app",
    "check": "npm run build"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "ajv": "8.20.0",
    "antd": "6.6.3",
    "commander": "15.0.0",
    "fastify": "5.12.4",
    "open": "11.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
